{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderEvent",
  "type": "object",
  "required": [
    "event_id",
    "order_id",
    "event_type",
    "event_time",
    "ingest_time"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT\\d{6}$"
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ORD\\d{6}$"
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CUST\\d{3}$"
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PRD\\d{3}$"
    },
    "quantity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "unit_price": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ORDER_CREATED",
        "ORDER_UPDATED",
        "ORDER_CANCELLED"
      ],
      "description": "Raw data also contains ORDER_ERR (to be rejected)"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "ingest_time": {
      "type": "string",
      "format": "date-time"
    },
    "sales_channel": {
      "type": [
        "string",
        "null"
      ],
      "description": "Appears only from the last micro-batch (schema evolution)"
    },
    "discount_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Appears only from the last micro-batch (schema evolution)"
    }
  }
}