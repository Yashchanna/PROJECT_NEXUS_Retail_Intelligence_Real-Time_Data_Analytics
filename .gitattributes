# Auto detect text files and perform LF normalization
* text=auto

# Custom formatting for specific extensions
*.scala text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.png binary
*.pptx binary
