# Build stage: Scala compiles against Spark 3.5.8 and produces a thin jar.
FROM eclipse-temurin:17-jdk AS builder
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tar gzip \
    && rm -rf /var/lib/apt/lists/*
ARG SBT_VERSION=1.10.11
RUN curl -fsSL "https://github.com/sbt/sbt/releases/download/v${SBT_VERSION}/sbt-${SBT_VERSION}.tgz" \
    | tar -xz -C /opt
WORKDIR /workspace
COPY project/ ./project/
COPY build.sbt ./
COPY src/ ./src/
RUN /opt/sbt/bin/sbt -batch package

# Runtime fetches Kafka and Iceberg Spark adapters via --packages on first start.
# For offline/prod deployment, bake adapter jars into the image instead.
FROM apache/spark:3.5.8-scala2.12-java17-python3-r-ubuntu
USER root
RUN mkdir -p /opt/nexus /app/output /home/spark/.ivy2 && chown -R 185:0 /opt/nexus /app/output /home/spark
COPY --from=builder /workspace/target/scala-2.12/nexus-realtime_2.12-0.2.0.jar /opt/nexus/nexus.jar
ENV HOME=/home/spark
ENV NEXUS_OUTPUT_DIR=/app/output
WORKDIR /app
USER 185
EXPOSE 4040
ENTRYPOINT ["/opt/spark/bin/spark-submit", "--master", "local[2]", "--driver-memory", "2g", "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.8,org.apache.iceberg:iceberg-spark-runtime-3.5_2.12:1.10.1", "--class", "com.nexus.StreamingJob", "/opt/nexus/nexus.jar"]
